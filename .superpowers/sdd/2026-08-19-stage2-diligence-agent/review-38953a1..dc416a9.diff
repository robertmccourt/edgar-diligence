+    value: float
+    unit: str
+    period_type: str
+    period_start: date | None
+    period_end: date
+    filed_date: date
+    accession: str
+    source_tag: str
+
+
+class MissingField(BaseModel):
+    model_config = ConfigDict(frozen=True)
+    canonical_field: str
+    status: str
+
+
+class GetFactsResult(BaseModel):
+    model_config = ConfigDict(frozen=True)
+    facts: list[FactDTO]
+    missing: list[MissingField]
+
+
+class CoverageEntry(BaseModel):
+    model_config = ConfigDict(frozen=True)
