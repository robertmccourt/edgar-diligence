+
+
+def _fact(con, *, fact_id, cik=1, field="revenue", value=100.0, unit="USD",
+          ptype="duration", pstart=date(2023, 1, 1), pend=date(2023, 3, 31),
+          filed=date(2023, 5, 1), accn="a-1", tag="Revenues", rule="MR-0003"):
