+def test_v1_loads_with_pinned_models():
+    cfg = load_agent_config("v1")
+    assert cfg.generation_model == "claude-opus-5"
+    assert cfg.judge_model == "claude-sonnet-5"
+    assert cfg.config_version.startswith("v1+")
