+def test_version_hash_moves_when_prompts_change(tmp_path):
+    import shutil
+    from pathlib import Path
+    root = tmp_path
+    shutil.copytree(Path("config"), root / "config")
+    shutil.copytree(Path("prompts"), root / "prompts")
